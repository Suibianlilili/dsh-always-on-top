{
  "name": "dsh-always-on-top",
  "version": "0.1.2",
  "description": "A tiny pin button for DSH Desktop: click once to keep the window always on top.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "always-on-top",
    "pin",
    "window",
    "desktop"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suibianlilili/dsh-always-on-top.git"
  },
  "homepage": "https://github.com/Suibianlilili/dsh-always-on-top#readme",
  "bugs": {
    "url": "https://github.com/Suibianlilili/dsh-always-on-top/issues"
  },
  "scripts": {
    "toggle-test": "node scripts/toggle-test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  }
}
